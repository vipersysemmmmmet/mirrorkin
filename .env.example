# AI brain (the server uses this; developers can also use it directly in the app)
ANTHROPIC_API_KEY=

# Soul Simulator server
# Public address of YOUR wallet that receives USDC payments (never put a seed phrase or private key here)
SOUL_PAY_TO=
# base-sepolia = test network with free test USDC; base = real money
SOUL_NETWORK=base-sepolia
# Tiny credits: people send USDC to the pool and get credits for it (public addresses only)
SOUL_POOL_ADDRESS=
# Gets the team fee from every credit purchase; change it any time (applies to new purchases)
SOUL_TEAM_ADDRESS=
# Team fee per credit purchase, in percent (e.g. 10 or 2.5; max 50)
SOUL_TEAM_FEE_PCT=10
# Credits per 1 USDC after the fee
SOUL_CREDITS_PER_USDC=100
# Optional: a blockchain provider URL (public endpoints are rate limited)
SOUL_RPC=
